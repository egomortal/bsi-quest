#version 450
#extension GL_GOOGLE_include_directive : require
// taa.comp -- job aa76: temporal AA resolve, one invocation per eye pixel of [eye.z, eye.w) x [0, height).
// In: the game's anti-aliasing input (tone-mapped LDR, back-buffer size), the scene depth (R32F copy of the D24 depth,
// device z, 1 = far), the previous history (2 eye widths x height, RGBA16F). Out: the new history = the displayed picture
// before sharpening. Per eye: neighbourhood + depth clamped to the eye column, history only from the same column.
layout(local_size_x = 8, local_size_y = 8) in;
#include "aa76_common.glsl"
layout(set = 0, binding = 1) uniform texture2D t_color;
layout(set = 0, binding = 2) uniform texture2D t_depth;
layout(set = 0, binding = 3) uniform texture2D t_hist;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D o_hist;

vec3 to_ycocg(vec3 c) { return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)), dot(c, vec3(-0.25, 0.5, -0.25))); }
vec3 to_rgb(vec3 y) { return vec3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z); }
// Playdead / INSIDE: move h towards the box centre until it is inside the box
vec3 clip_box(vec3 lo, vec3 hi, vec3 h) {
  vec3 c = 0.5 * (hi + lo), ex = 0.5 * (hi - lo) + 1e-4, v = h - c, a = abs(v / ex);
  float k = max(a.x, max(a.y, a.z));
  return k > 1.0 ? c + v / k : h;
}
ivec2 lo_, hi_;
vec3 hfetch(ivec2 q) { return texelFetch(t_hist, clamp(q, lo_, hi_), 0).rgb; }

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy) + ivec2(eye.z, 0);
  int ew = eye.x, H = eye.y;
  if (p.x >= eye.w || p.y >= H) return;
  int e = eye_of(p.x), x0 = e * ew;
  lo_ = ivec2(x0, 0); hi_ = ivec2(x0 + ew - 1, H - 1);
  int flags = prm.y;

  // 3x3 neighbourhood of the new frame (YCoCg): mean / variance box and min / max, and the new frame reconstructed at the
  // pixel centre: the projection jitter moved every sample by (jit.x, -jit.y) buffer pixels, so the sample of pixel p + o
  // shows the scene at offset o - J from p's (unjittered) centre; Blackman-Harris-like weights exp(-2.29 d^2) (UE4's
  // approximation, filter radius ~1 px). Without it the jittered sample itself enters the history and a still picture
  // keeps a small jitter shimmer (cloud run M of build e: still-head flicker 1.13 vs 0.58 without TAA).
  vec3 m1 = vec3(0.0), m2 = vec3(0.0), mn = vec3(1e9), mx = vec3(-1e9), cur = vec3(0.0), cf = vec3(0.0);
  vec2 J = vec2(jit.x, -jit.y); float wsum = 0.0;
  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
    vec3 c = to_ycocg(texelFetch(t_color, clamp(p + ivec2(i, j), lo_, hi_), 0).rgb);
    m1 += c; m2 += c * c; mn = min(mn, c); mx = max(mx, c);
    vec2 d = vec2(float(i), float(j)) - J; float w = exp(-2.29 * dot(d, d));
    cf += w * c; wsum += w;
    if (i == 0 && j == 0) cur = c;
  }
  if ((flags & F_NOFILTER) == 0) cur = cf / wsum;
  vec3 mu = m1 * (1.0 / 9.0), sd = sqrt(max(m2 * (1.0 / 9.0) - mu * mu, vec3(0.0)));
  vec3 blo = max(mn, mu - taa.y * sd), bhi = min(mx, mu + taa.y * sd);

  bool reset = (flags & F_HIST) == 0 || (flags & (e == 0 ? F_RESET0 : F_RESET1)) != 0;
  vec3 res = cur;
  if (!reset) {
    // nearest depth of the cross (the foreground wins at silhouettes: less ghosting along edges)
    float d = 1.0;
    if ((flags & F_NODEPTH) == 0) {
      d = texelFetch(t_depth, p, 0).r;
      d = min(d, texelFetch(t_depth, clamp(p + ivec2(-1, 0), lo_, hi_), 0).r);
      d = min(d, texelFetch(t_depth, clamp(p + ivec2( 1, 0), lo_, hi_), 0).r);
      d = min(d, texelFetch(t_depth, clamp(p + ivec2(0, -1), lo_, hi_), 0).r);
      d = min(d, texelFetch(t_depth, clamp(p + ivec2(0,  1), lo_, hi_), 0).r);
    }
    vec2 ndc = vec2((float(p.x - x0) + 0.5) / float(ew) * 2.0 - 1.0, 1.0 - (float(p.y) + 0.5) / float(H) * 2.0);
    vec4 c = ndc.x * m[e * 4] + ndc.y * m[e * 4 + 1] + d * m[e * 4 + 2] + m[e * 4 + 3];
    // a pixel of the sky (depth 1.0 = beyond the infinite-far projection's limit) comes back with w < 0: the same direction,
    // so the ratio is used whatever the sign (pure rotation exact; with a camera move the error is far below a pixel)
    vec2 q = vec2(-1e9);
    if (abs(c.w) > 1e-7) { vec2 u = c.xy / c.w; q = vec2(float(x0) + (u.x * 0.5 + 0.5) * float(ew), (0.5 - u.y * 0.5) * float(H)); }
    if (q.x >= float(x0) && q.x < float(x0 + ew) && q.y >= 0.0 && q.y < float(H)) {
      vec2 f = q - 0.5, fl = floor(f), t = f - fl; ivec2 b = ivec2(fl);
      vec3 h;
      if ((flags & F_CUBIC) != 0) {
        // Catmull-Rom, 4x4 taps without the 4 corners (their weights are <= 1/256), renormalised
        vec2 w0 = t * (-0.5 + t * (1.0 - 0.5 * t)), w1 = 1.0 + t * t * (-2.5 + 1.5 * t);
        vec2 w2 = t * (0.5 + t * (2.0 - 1.5 * t)), w3 = t * t * (-0.5 + 0.5 * t);
        vec3 s = vec3(0.0); float ws = 0.0;
        #define TAP(ox, oy, wx, wy) { float w_ = (wx) * (wy); s += w_ * hfetch(b + ivec2(ox, oy)); ws += w_; }
        TAP( 0, -1, w1.x, w0.y) TAP( 1, -1, w2.x, w0.y)
        TAP(-1,  0, w0.x, w1.y) TAP( 0,  0, w1.x, w1.y) TAP( 1,  0, w2.x, w1.y) TAP( 2,  0, w3.x, w1.y)
        TAP(-1,  1, w0.x, w2.y) TAP( 0,  1, w1.x, w2.y) TAP( 1,  1, w2.x, w2.y) TAP( 2,  1, w3.x, w2.y)
        TAP( 0,  2, w1.x, w3.y) TAP( 1,  2, w2.x, w3.y)
        h = max(s / ws, vec3(0.0));
      } else {
        h = mix(mix(hfetch(b), hfetch(b + ivec2(1, 0)), t.x), mix(hfetch(b + ivec2(0, 1)), hfetch(b + ivec2(1, 1)), t.x), t.y);
      }
      vec3 hy = clip_box(blo, bhi, to_ycocg(h));
      // blend; luma-weighted (bright sub-pixel sparkles do not dominate the average)
      float a = taa.x, wc = a / (1.0 + cur.x), wh = (1.0 - a) / (1.0 + hy.x);
      res = (cur * wc + hy * wh) / (wc + wh);
    }
  }
  imageStore(o_hist, p, vec4(max(to_rgb(res), vec3(0.0)), 1.0));
}
