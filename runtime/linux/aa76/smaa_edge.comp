#version 450
#extension GL_GOOGLE_include_directive : require
// smaa_edge.comp -- job aa76: SMAA 1x pass 1 (luma edge detection) per eye pixel -> edges (RGBA8, rg used)
layout(local_size_x = 8, local_size_y = 8) in;
#include "aa76_common.glsl"
layout(set = 0, binding = 1) uniform texture2D t_color;
layout(set = 0, binding = 9, rgba8) uniform writeonly image2D o_edges;
#define HAVE_COLOR 1
#include "smaa_port.glsl"
#define discard return vec2(0.0)
#include "SMAA.hlsl"
void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy) + ivec2(eye.z, 0);
  if (p.x >= eye.w || p.y >= eye.y) return;
  int x0 = eye_of(p.x) * eye.x; g_lo = ivec2(x0, 0); g_hi = ivec2(x0 + eye.x - 1, eye.y - 1);
  vec2 tc = (vec2(p) + 0.5) * rt.xy; vec4 off[3];
  SMAAEdgeDetectionVS(tc, off);
  vec2 e = SMAALumaEdgeDetectionPS(tc, off, 0);
  imageStore(o_edges, p, vec4(e, 0.0, 0.0));
}
