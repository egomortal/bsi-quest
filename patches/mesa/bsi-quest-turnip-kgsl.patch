From 59e13227a562e07db8543ea01a70d455f9618508 Mon Sep 17 00:00:00 2001
From: BSI-Quest <bsi-quest@users.noreply.github.com>
Date: Mon, 26 Oct 2026 17:57:06 -0400
Subject: [PATCH 2/3] tu/kgsl: allocate BOs with GPUOBJ_ALLOC (Quest 3 kernel
 denies GPUMEM_ALLOC_ID with EACCES)

BSI_KGSL_GPUMEM_ALLOC_ID=1 restores the upstream ioctl. Local BSI-Quest change, not for upstream.

Generated-by: LLM
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01APmrQN4bQfuBwjXq4EWFW9
---
 src/freedreno/vulkan/tu_knl_kgsl.cc | 51 ++++++++++++++++++++++++-----
 1 file changed, 42 insertions(+), 9 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index bcba73bb..a0fba331 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -345,15 +345,48 @@ kgsl_bo_init(struct tu_device *dev,
 
    int ret;
 
-   ret = safe_ioctl(dev->physical_device->local_fd,
-                    IOCTL_KGSL_GPUMEM_ALLOC_ID, &req);
-   if (ret) {
-      int err = errno;
-      /* BSI-Quest: always log (vk_errorf is silent without a debug messenger) */
-      mesa_loge("kgsl GPUMEM_ALLOC_ID failed: size %" PRIu64 " align %" PRIu64 " flags 0x%x name %s ret %d errno %d (%s)",
-                size, align, req.flags, name ? name : "?", ret, err, strerror(err));
-      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
-                       "GPUMEM_ALLOC_ID failed (%s)", strerror(err));
+   /* BSI-Quest (Quest 3, Meta kernel): IOCTL_KGSL_GPUMEM_ALLOC_ID is answered with EACCES for apps, while
+    * IOCTL_KGSL_GPUOBJ_ALLOC works (the only Turnip builds that ever ran on the Quest allocate through it).
+    * Default: GPUOBJ_ALLOC with the same flags (+ GPUMEM_GET_INFO for the address); BSI_KGSL_GPUMEM_ALLOC_ID=1
+    * restores upstream behaviour. */
+   static int use_gpuobj = -1;
+   if (use_gpuobj < 0) { const char *e = getenv("BSI_KGSL_GPUMEM_ALLOC_ID"); use_gpuobj = !(e && atoi(e) != 0); }
+   if (use_gpuobj) {
+      struct kgsl_gpuobj_alloc oreq = {
+         .size = size,
+         .flags = req.flags,
+         .va_len = 0,
+      };
+      ret = safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUOBJ_ALLOC, &oreq);
+      if (ret) {
+         int err = errno;
+         mesa_loge("kgsl GPUOBJ_ALLOC failed: size %" PRIu64 " align %" PRIu64 " flags 0x%llx name %s ret %d errno %d (%s)",
+                   size, align, (unsigned long long)oreq.flags, name ? name : "?", ret, err, strerror(err));
+         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY, "GPUOBJ_ALLOC failed (%s)", strerror(err));
+      }
+      struct kgsl_gpumem_get_info info = { .id = oreq.id };
+      ret = safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_GET_INFO, &info);
+      if (ret) {
+         int err = errno;
+         struct kgsl_gpuobj_free freq = { .id = oreq.id };
+         safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUOBJ_FREE, &freq);
+         mesa_loge("kgsl GPUMEM_GET_INFO failed after GPUOBJ_ALLOC: id %u errno %d (%s)", oreq.id, err, strerror(err));
+         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY, "GPUMEM_GET_INFO failed (%s)", strerror(err));
+      }
+      req.id = oreq.id;
+      req.mmapsize = oreq.mmapsize;
+      req.gpuaddr = info.gpuaddr;
+   } else {
+      ret = safe_ioctl(dev->physical_device->local_fd,
+                       IOCTL_KGSL_GPUMEM_ALLOC_ID, &req);
+      if (ret) {
+         int err = errno;
+         /* BSI-Quest: always log (vk_errorf is silent without a debug messenger) */
+         mesa_loge("kgsl GPUMEM_ALLOC_ID failed: size %" PRIu64 " align %" PRIu64 " flags 0x%x name %s ret %d errno %d (%s)",
+                   size, align, req.flags, name ? name : "?", ret, err, strerror(err));
+         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "GPUMEM_ALLOC_ID failed (%s)", strerror(err));
+      }
    }
 
    struct tu_bo* bo = tu_device_lookup_bo(dev, req.id);
-- 
