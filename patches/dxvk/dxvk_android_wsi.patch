diff --git a/src/dxvk/dxvk_device_info.cpp b/src/dxvk/dxvk_device_info.cpp
index ab1f563..1989818 100644
--- a/src/dxvk/dxvk_device_info.cpp
+++ b/src/dxvk/dxvk_device_info.cpp
@@ -773,6 +773,7 @@ namespace dxvk {
     if (m_queueMapping.graphics.family == VK_QUEUE_FAMILY_IGNORED)
       return std::string("Device does not have a graphics queue");
 
+    std::optional<std::string> firstMissing;
     for (const auto& f : getFeatureList()) {
       if (f.featureRequired && !(*f.featureEnabled)) {
         std::string message = str::format("Device does not support required feature '", f.readableName, "'");
@@ -780,9 +781,13 @@ namespace dxvk {
         if (f.extensionEnabled)
           message += str::format(" (extension: ", f.extensionEnabled->extensionName, ")");
 
-        return message;
+        Logger::warn(str::format("  missing: ", message));
+        if (!firstMissing)
+          firstMissing = message;
       }
     }
+    if (firstMissing)
+      return firstMissing;
 
     if (!m_featuresEnabled.extDescriptorHeap.descriptorHeap && m_properties.core.properties.limits.maxPushConstantsSize < MaxTotalPushDataSize)
       return str::format("Device does not support ", MaxTotalPushDataSize, " of push data");
diff --git a/src/vulkan/vulkan_loader.cpp b/src/vulkan/vulkan_loader.cpp
index f9d1e98..aca10e0 100644
--- a/src/vulkan/vulkan_loader.cpp
+++ b/src/vulkan/vulkan_loader.cpp
@@ -1,4 +1,5 @@
 #include <tuple>
+#include <cstdlib>
 
 #include "vulkan_loader.h"
 
@@ -10,6 +11,29 @@
 namespace dxvk::vk {
 
   static std::pair<HMODULE, PFN_vkGetInstanceProcAddr> loadVulkanLibrary() {
+    /* BSI-Quest: optional custom driver, e.g. a Turnip (Mesa) ICD shipped with the app */
+    if (const char* h = getenv("BSI_VULKAN_HANDLE")) {
+      /* libvulkan instance opened by the app (e.g. through adrenotools with a custom driver) */
+      HMODULE library = reinterpret_cast<HMODULE>(strtoull(h, nullptr, 16));
+      auto proc = library ? GetProcAddress(library, "vkGetInstanceProcAddr") : nullptr;
+      if (proc) {
+        Logger::info("Vulkan: using app-provided libvulkan handle (custom driver)");
+        return std::make_pair(library, reinterpret_cast<PFN_vkGetInstanceProcAddr>(proc));
+      }
+      Logger::err("Vulkan: app-provided libvulkan handle has no vkGetInstanceProcAddr, falling back");
+    }
+    if (const char* custom = getenv("BSI_VULKAN_LIB")) {
+      if (HMODULE library = LoadLibraryA(custom)) {
+        auto proc = GetProcAddress(library, "vkGetInstanceProcAddr");
+        if (!proc) proc = GetProcAddress(library, "vk_icdGetInstanceProcAddr");
+        if (proc) {
+          Logger::info(str::format("Vulkan: using custom driver ", custom));
+          return std::make_pair(library, reinterpret_cast<PFN_vkGetInstanceProcAddr>(proc));
+        }
+        FreeLibrary(library);
+      }
+      Logger::err(str::format("Vulkan: could not load custom driver ", custom, ", falling back to the system loader"));
+    }
     static const std::array<const char*, 2> dllNames = {{
 #ifdef _WIN32
       "winevulkan.dll",
-- 
