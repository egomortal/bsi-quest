diff --git a/src/wsi/android/wsi_platform_android.cpp b/src/wsi/android/wsi_platform_android.cpp
new file mode 100644
index 0000000..e6561e5
--- /dev/null
+++ b/src/wsi/android/wsi_platform_android.cpp
@@ -0,0 +1,72 @@
+#if defined(DXVK_WSI_ANDROID)
+// Android WSI for DXVK native (BSI-Quest): HWND is an ANativeWindow*. One "monitor" = the window's surface.
+#include "../wsi_platform.h"
+#include "../wsi_monitor.h"
+#include "../wsi_window.h"
+#include "../../util/util_error.h"
+#include "../../util/log/log.h"
+#include <android/native_window.h>
+#include <vulkan/vulkan_android.h>
+#include <cstring>
+#include <cstdlib>
+
+namespace dxvk::wsi {
+
+  static ANativeWindow* toWin(HWND h) { return reinterpret_cast<ANativeWindow*>(h); }
+  static void winSize(HWND h, uint32_t* w, uint32_t* hh) {
+    int32_t W = 1920, H = 1080;
+    if (h) { W = ANativeWindow_getWidth(toWin(h)); H = ANativeWindow_getHeight(toWin(h)); }
+    else if (const char* e = getenv("BSI_ANDROID_SIZE")) { sscanf(e, "%dx%d", &W, &H); }
+    if (w) *w = uint32_t(W); if (hh) *hh = uint32_t(H);
+  }
+
+  class AndroidWsiDriver : public WsiDriver {
+  public:
+    std::vector<const char *> getInstanceExtensions() override {
+      return { VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_ANDROID_SURFACE_EXTENSION_NAME };
+    }
+    HMONITOR getDefaultMonitor() override { return enumMonitors(0); }
+    HMONITOR enumMonitors(uint32_t index) override { return index == 0 ? reinterpret_cast<HMONITOR>(intptr_t(1)) : nullptr; }
+    HMONITOR enumMonitors(const LUID *adapterLUID[], uint32_t numLUIDs, uint32_t index) override { return enumMonitors(index); }
+    bool getDisplayName(HMONITOR hMonitor, WCHAR (&Name)[32]) override {
+      std::memset(Name, 0, sizeof(Name)); const char* n = "\\\\.\\DISPLAY1";
+      for (int i = 0; n[i]; i++) Name[i] = WCHAR(n[i]); return true;
+    }
+    bool getDesktopCoordinates(HMONITOR hMonitor, RECT* pRect) override {
+      uint32_t w, h; winSize(nullptr, &w, &h);
+      pRect->left = 0; pRect->top = 0; pRect->right = LONG(w); pRect->bottom = LONG(h); return true;
+    }
+    bool mode(uint32_t n, WsiMode* m) {
+      if (n > 0) return false; uint32_t w, h; winSize(nullptr, &w, &h);
+      m->width = w; m->height = h; m->refreshRate = WsiRational{ 72000, 1000 }; m->bitsPerPixel = 32; m->interlaced = false; return true;
+    }
+    bool getDisplayMode(HMONITOR, uint32_t n, WsiMode* m) override { return mode(n, m); }
+    bool getCurrentDisplayMode(HMONITOR, WsiMode* m) override { return mode(0, m); }
+    bool getDesktopDisplayMode(HMONITOR, WsiMode* m) override { return mode(0, m); }
+    WsiEdidData getMonitorEdid(HMONITOR) override { return {}; }
+    void getWindowSize(HWND h, uint32_t* w, uint32_t* hh) override { winSize(h, w, hh); }
+    void resizeWindow(HWND, DxvkWindowState*, uint32_t, uint32_t) override { }
+    void saveWindowState(HWND, DxvkWindowState*, bool) override { }
+    void restoreWindowState(HWND, DxvkWindowState*, bool) override { }
+    bool setWindowMode(HMONITOR, HWND, DxvkWindowState*, const WsiMode&) override { return true; }
+    bool enterFullscreenMode(HMONITOR, HWND, DxvkWindowState*, bool) override { return true; }
+    bool leaveFullscreenMode(HWND, DxvkWindowState*) override { return true; }
+    bool restoreDisplayMode() override { return true; }
+    HMONITOR getWindowMonitor(HWND) override { return reinterpret_cast<HMONITOR>(intptr_t(1)); }
+    bool isWindow(HWND h) override { return h != nullptr; }
+    bool isMinimized(HWND) override { return false; }
+    bool isOccluded(HWND) override { return false; }
+    void updateFullscreenWindow(HMONITOR, HWND, bool) override { }
+    VkResult createSurface(HWND h, PFN_vkGetInstanceProcAddr gpa, VkInstance instance, VkSurfaceKHR* pSurface) override {
+      auto fn = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(gpa(instance, "vkCreateAndroidSurfaceKHR"));
+      if (!fn) return VK_ERROR_EXTENSION_NOT_PRESENT;
+      VkAndroidSurfaceCreateInfoKHR ci = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+      ci.window = toWin(h);
+      return fn(instance, &ci, nullptr, pSurface);
+    }
+  };
+
+  static bool createAndroidWsiDriver(WsiDriver **driver) { *driver = new AndroidWsiDriver(); return true; }
+  WsiBootstrap AndroidWSI = { "Android", createAndroidWsiDriver };
+}
+#endif
