 src/wsi/android/wsi_platform_android.cpp | 72 ++++++++++++++++++++++++
 src/wsi/meson.build                      |  4 ++
 src/wsi/wsi_platform.cpp                 |  5 ++
 src/wsi/wsi_platform.h                   |  3 +
