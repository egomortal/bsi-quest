diff --git a/src/dxvk/dxvk_shader_replace.cpp b/src/dxvk/dxvk_shader_replace.cpp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/dxvk_shader_replace.cpp
@@ -0,0 +1,365 @@
+// BSI local patch (never upstream): load replacement SPIR-V for individual
+// shaders by name, see dxvk_shader_replace.h.
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <memory>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <unordered_map>
+
+#include "dxvk_shader_replace.h"
+
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+
+namespace dxvk {
+
+  namespace {
+
+    constexpr uint32_t OpName           = 5u;
+    constexpr uint32_t OpMemberName     = 6u;
+    constexpr uint32_t OpTypePointer    = 32u;
+    constexpr uint32_t OpVariable       = 59u;
+    constexpr uint32_t OpDecorate       = 71u;
+    constexpr uint32_t OpMemberDecorate = 72u;
+
+    constexpr uint32_t DecBinding       = 33u;
+    constexpr uint32_t DecDescriptorSet = 34u;
+    constexpr uint32_t DecOffset        = 35u;
+
+    constexpr uint32_t ScPushConstant   = 9u;
+
+    struct SpvInterface {
+      std::unordered_map<uint32_t, std::string> names;
+      std::map<std::pair<uint32_t, uint32_t>, std::string> memberNames;
+      // id -> word index of the literal operand, for patching
+      std::unordered_map<uint32_t, size_t> setWord;
+      std::unordered_map<uint32_t, size_t> bindingWord;
+      // (struct, member) -> word index of the offset literal
+      std::map<std::pair<uint32_t, uint32_t>, size_t> offsetWord;
+      std::unordered_map<uint32_t, uint32_t> pushPtrToStruct;
+      std::vector<uint32_t> pushStructs;
+    };
+
+    std::string readString(const uint32_t* words, size_t count) {
+      std::string s;
+      for (size_t i = 0; i < count; i++) {
+        for (uint32_t b = 0; b < 4; b++) {
+          char c = char((words[i] >> (8u * b)) & 0xffu);
+          if (!c)
+            return s;
+          s.push_back(c);
+        }
+      }
+      return s;
+    }
+
+    bool parse(const uint32_t* code, size_t dwords, SpvInterface& io) {
+      if (dwords < 5u || code[0] != 0x07230203u)
+        return false;
+
+      std::vector<std::pair<uint32_t, uint32_t>> pushVars; // (ptr type, var)
+
+      size_t i = 5u;
+      while (i < dwords) {
+        uint32_t len = code[i] >> 16;
+        uint32_t op  = code[i] & 0xffffu;
+
+        if (!len || i + len > dwords)
+          return false;
+
+        const uint32_t* w = &code[i];
+
+        switch (op) {
+          case OpName:
+            if (len >= 3u) io.names[w[1]] = readString(&w[2], len - 2u);
+            break;
+          case OpMemberName:
+            if (len >= 4u) io.memberNames[{ w[1], w[2] }] = readString(&w[3], len - 3u);
+            break;
+          case OpDecorate:
+            if (len >= 4u && w[2] == DecDescriptorSet) io.setWord[w[1]] = i + 3u;
+            if (len >= 4u && w[2] == DecBinding)       io.bindingWord[w[1]] = i + 3u;
+            break;
+          case OpMemberDecorate:
+            if (len >= 5u && w[3] == DecOffset) io.offsetWord[{ w[1], w[2] }] = i + 4u;
+            break;
+          case OpTypePointer:
+            if (len >= 4u && w[2] == ScPushConstant) io.pushPtrToStruct[w[1]] = w[3];
+            break;
+          case OpVariable:
+            if (len >= 4u && w[3] == ScPushConstant) pushVars.push_back({ w[1], w[2] });
+            break;
+          default:
+            break;
+        }
+
+        i += len;
+      }
+
+      for (const auto& v : pushVars) {
+        auto e = io.pushPtrToStruct.find(v.first);
+        if (e != io.pushPtrToStruct.end())
+          io.pushStructs.push_back(e->second);
+      }
+
+      return true;
+    }
+
+
+    struct Variant {
+      uint64_t srcHash = 0u;
+      std::string file;
+      std::array<uint32_t, 3> dispatchScale = {{ 1u, 1u, 1u }};
+      std::unique_ptr<DxvkShaderReplacement> loaded;
+      bool tried = false;
+    };
+
+    struct Registry {
+      std::mutex mutex;
+      bool initialized = false;
+      std::string dir;
+      std::unordered_map<std::string, std::vector<Variant>> cache;
+    };
+
+    Registry& registry() {
+      static Registry s_registry;
+      return s_registry;
+    }
+
+    void initRegistry(Registry& reg) {
+      if (reg.initialized)
+        return;
+
+      reg.dir = env::getEnvVar("BSI_SHADER_REPLACE");
+      reg.initialized = true;
+
+      if (!reg.dir.empty())
+        Logger::info(str::format("BSI shader replacement: ", reg.dir));
+    }
+
+    std::vector<Variant>& variants(Registry& reg, const std::string& name) {
+      auto entry = reg.cache.find(name);
+      if (entry != reg.cache.end())
+        return entry->second;
+
+      std::vector<Variant> list;
+      std::ifstream txt(str::topath(str::format(reg.dir, "/", name, ".txt").c_str()).c_str());
+      std::string line;
+
+      while (txt && std::getline(txt, line)) {
+        std::istringstream ls(line);
+        std::string key, hash;
+        ls >> key;
+
+        if (key != "variant")
+          continue;
+
+        Variant v;
+        ls >> hash >> v.file;
+        v.srcHash = std::strtoull(hash.c_str(), nullptr, 16);
+
+        std::string opt;
+        while (ls >> opt) {
+          if (opt == "dispatch_scale") {
+            for (uint32_t k = 0; k < 3u; k++) {
+              uint32_t n = 1u;
+              if (ls >> n)
+                v.dispatchScale[k] = std::max(n, 1u);
+            }
+          }
+        }
+
+        if (!v.file.empty())
+          list.push_back(std::move(v));
+      }
+
+      return reg.cache.emplace(name, std::move(list)).first->second;
+    }
+
+  }
+
+
+  bool DxvkShaderReplacer::enabled() {
+    auto& reg = registry();
+    std::lock_guard lock(reg.mutex);
+    initRegistry(reg);
+    return !reg.dir.empty();
+  }
+
+
+  bool DxvkShaderReplacer::has(const std::string& name) {
+    auto& reg = registry();
+    std::lock_guard lock(reg.mutex);
+    initRegistry(reg);
+    return !reg.dir.empty() && !variants(reg, name).empty();
+  }
+
+
+  uint64_t DxvkShaderReplacer::hash(const uint32_t* code, size_t dwords) {
+    uint64_t h = 0xcbf29ce484222325ull;
+
+    for (size_t i = 0; i < dwords; i++) {
+      for (uint32_t b = 0; b < 4u; b++) {
+        h ^= (code[i] >> (8u * b)) & 0xffu;
+        h *= 0x100000001b3ull;
+      }
+    }
+
+    return h;
+  }
+
+
+  const DxvkShaderReplacement* DxvkShaderReplacer::find(
+    const std::string&            name,
+    const SpirvCodeBuffer&        original) {
+    auto& reg = registry();
+    std::lock_guard lock(reg.mutex);
+    initRegistry(reg);
+
+    if (reg.dir.empty())
+      return nullptr;
+
+    auto& list = variants(reg, name);
+
+    if (list.empty())
+      return nullptr;
+
+    uint64_t srcHash = hash(original.data(), original.dwords());
+
+    for (auto& v : list) {
+      if (v.srcHash != srcHash)
+        continue;
+
+      if (!v.tried) {
+        v.tried = true;
+
+        std::ifstream spv(str::topath(str::format(reg.dir, "/", v.file).c_str()).c_str(), std::ios::binary);
+        std::vector<char> bytes;
+
+        if (spv)
+          bytes.assign((std::istreambuf_iterator<char>(spv)), std::istreambuf_iterator<char>());
+
+        if (bytes.size() >= 20u && !(bytes.size() & 3u)) {
+          v.loaded = std::make_unique<DxvkShaderReplacement>();
+          v.loaded->file = v.file;
+          v.loaded->srcHash = v.srcHash;
+          v.loaded->dispatchScale = v.dispatchScale;
+          v.loaded->code.resize(bytes.size() / 4u);
+          std::memcpy(v.loaded->code.data(), bytes.data(), bytes.size());
+
+          Logger::info(str::format("BSI shader replacement: ", name, " -> ", v.file, " (", bytes.size(), " bytes, dispatch scale ",
+            v.dispatchScale[0], "x", v.dispatchScale[1], "x", v.dispatchScale[2], ")"));
+        } else {
+          Logger::err(str::format("BSI shader replacement: ", v.file, " missing or not SPIR-V"));
+        }
+      }
+
+      return v.loaded.get();
+    }
+
+    char hex[24];
+    std::snprintf(hex, sizeof(hex), "%016llx", (unsigned long long) srcHash);
+    Logger::warn(str::format("BSI shader replacement: ", name, ": no variant for source hash ",
+      hex, ", keeping the original shader"));
+    return nullptr;
+  }
+
+
+  bool DxvkShaderReplacer::patch(
+    const std::string&            name,
+    const DxvkShaderReplacement&  repl,
+    const SpirvCodeBuffer&        original,
+          SpirvCodeBuffer&        result) {
+    SpvInterface src, dst;
+
+    if (!parse(original.data(), original.dwords(), src)) {
+      Logger::err(str::format("BSI shader replacement: ", name, ": failed to parse original SPIR-V"));
+      return false;
+    }
+
+    std::vector<uint32_t> code = repl.code;
+
+    if (!parse(code.data(), code.size(), dst)) {
+      Logger::err(str::format("BSI shader replacement: ", name, ": failed to parse replacement SPIR-V"));
+      return false;
+    }
+
+    // Original descriptor variables by debug name
+    std::unordered_map<std::string, uint32_t> srcByName;
+
+    for (const auto& e : src.setWord) {
+      auto n = src.names.find(e.first);
+
+      if (n != src.names.end() && !n->second.empty())
+        srcByName[n->second] = e.first;
+    }
+
+    for (const auto& e : dst.setWord) {
+      auto n = dst.names.find(e.first);
+
+      if (n == dst.names.end() || srcByName.find(n->second) == srcByName.end()) {
+        Logger::err(str::format("BSI shader replacement: ", name, ": descriptor '",
+          n != dst.names.end() ? n->second : std::string("<unnamed>"), "' not in the original"));
+        return false;
+      }
+
+      uint32_t srcId = srcByName[n->second];
+      auto b = dst.bindingWord.find(e.first);
+      auto sb = src.bindingWord.find(srcId);
+
+      if (b == dst.bindingWord.end() || sb == src.bindingWord.end()) {
+        Logger::err(str::format("BSI shader replacement: ", name, ": '", n->second, "' has no binding"));
+        return false;
+      }
+
+      code[e.second] = original.data()[src.setWord[srcId]];
+      code[b->second] = original.data()[sb->second];
+    }
+
+    // Push data members by debug name
+    if (!dst.pushStructs.empty()) {
+      std::unordered_map<std::string, size_t> srcMembers;
+
+      for (uint32_t s : src.pushStructs) {
+        for (const auto& m : src.memberNames) {
+          if (m.first.first != s)
+            continue;
+
+          auto o = src.offsetWord.find(m.first);
+
+          if (o != src.offsetWord.end())
+            srcMembers[m.second] = o->second;
+        }
+      }
+
+      for (uint32_t s : dst.pushStructs) {
+        for (const auto& o : dst.offsetWord) {
+          if (o.first.first != s)
+            continue;
+
+          auto m = dst.memberNames.find(o.first);
+          auto e = m != dst.memberNames.end() ? srcMembers.find(m->second) : srcMembers.end();
+
+          if (e == srcMembers.end()) {
+            Logger::err(str::format("BSI shader replacement: ", name, ": push data member '",
+              m != dst.memberNames.end() ? m->second : std::string("<unnamed>"), "' not in the original"));
+            return false;
+          }
+
+          code[o.second] = original.data()[e->second];
+        }
+      }
+    }
+
+    result = SpirvCodeBuffer(std::move(code));
+    return true;
+  }
+
+}
diff --git a/src/dxvk/dxvk_shader_replace.h b/src/dxvk/dxvk_shader_replace.h
new file mode 100644
--- /dev/null
+++ b/src/dxvk/dxvk_shader_replace.h
@@ -0,0 +1,95 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "../spirv/spirv_code_buffer.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Replacement shader (BSI local patch, never upstream)
+   *
+   * Enabled with \c BSI_SHADER_REPLACE=<dir>. For a shader whose DXVK debug
+   * name is \c <name> (the name \c DXVK_SHADER_DUMP_PATH uses, e.g.
+   * \c cs.<md5>), \c <dir>/<name>.txt lists the available variants:
+   *
+   *   variant <srchash> <file.spv> [dispatch_scale X Y Z]
+   *
+   * \c <srchash> is the 64-bit FNV-1a hash (16 hex digits) of the original
+   * shader's unmapped SPIR-V, i.e. exactly the \c <name>.spv file that
+   * \c DXVK_SHADER_DUMP_PATH writes on that device. A variant is only used if
+   * its hash matches the original that DXVK produced on this device and DXVK
+   * version, so a replacement derived from one device's code is never applied
+   * to different code (other driver options, other DXVK build): those fall
+   * back to the original shader.
+   *
+   * \c dispatch_scale multiplies the Dispatch() group counts (a compute
+   * replacement with smaller workgroups covering the same pixels).
+   *
+   * The replacement declares its resources with the same debug names as the
+   * original (OpName on descriptor variables, OpMemberName on push-data
+   * members). Set/binding decorations and push-data member offsets are
+   * copied from the original's final SPIR-V at pipeline compile time, so the
+   * replacement follows whatever binding model DXVK picked on the device. Any
+   * mismatch logs an error and keeps the original shader.
+   */
+  struct DxvkShaderReplacement {
+    std::string             file;
+    uint64_t                srcHash = 0u;
+    std::vector<uint32_t>   code;
+    std::array<uint32_t, 3> dispatchScale = {{ 1u, 1u, 1u }};
+  };
+
+
+  class DxvkShaderReplacer {
+
+  public:
+
+    /**
+     * \brief Whether replacement is enabled at all
+     */
+    static bool enabled();
+
+    /**
+     * \brief Whether any replacement variant is listed for a shader name
+     */
+    static bool has(const std::string& name);
+
+    /**
+     * \brief Looks up a replacement for a shader
+     *
+     * \param [in] name Shader debug name
+     * \param [in] original Unmapped SPIR-V of the original shader
+     *    (the code \c DXVK_SHADER_DUMP_PATH writes)
+     * \returns Matching replacement, or \c nullptr
+     */
+    static const DxvkShaderReplacement* find(
+      const std::string&            name,
+      const SpirvCodeBuffer&        original);
+
+    /**
+     * \brief Builds the final replacement code
+     *
+     * \param [in] name Shader name (for logging)
+     * \param [in] repl Replacement
+     * \param [in] original Final SPIR-V of the original shader
+     * \param [out] result Patched replacement code
+     * \returns \c true on success
+     */
+    static bool patch(
+      const std::string&            name,
+      const DxvkShaderReplacement&  repl,
+      const SpirvCodeBuffer&        original,
+            SpirvCodeBuffer&        result);
+
+    /**
+     * \brief 64-bit FNV-1a over SPIR-V words (little-endian bytes)
+     */
+    static uint64_t hash(const uint32_t* code, size_t dwords);
+
+  };
+
+}
