diff --git a/src/d3d11/d3d11_bsi_capture.cpp b/src/d3d11/d3d11_bsi_capture.cpp
new file mode 100644
--- /dev/null
+++ b/src/d3d11/d3d11_bsi_capture.cpp
@@ -0,0 +1,355 @@
+// BSI local patch (never upstream): debug capture of compute dispatches.
+//
+// BSI_CS_CAPTURE=<dir>: when <dir>/go exists, the next N immediate-context
+// Dispatch calls (N = number in the go file, default 3) are captured into
+// <dir>/cap<k>/d<i>_*: shader name + group counts (info.txt), bound SRVs
+// (texture desc, view desc, mip data), constant buffers, samplers and UAVs
+// before and after the dispatch. The go file is then renamed to done<k>.
+// Used to replay a pass offline (tools: bsi hdao replay harness).
+#include <cstdio>
+#include <fstream>
+#include <string>
+#include <vector>
+#include <unistd.h>
+
+#include "d3d11_bsi_capture.h"
+#include "d3d11_shader.h"
+
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+
+namespace dxvk {
+
+  namespace {
+
+    struct CaptureState {
+      bool        init = false;
+      std::string dir;
+      uint32_t    session = 0u;
+      uint32_t    remaining = 0u;
+      uint32_t    index = 0u;
+      std::string out;
+    };
+
+    CaptureState& state() {
+      static CaptureState s;
+      return s;
+    }
+
+    void writeFile(const std::string& path, const void* data, size_t size) {
+      std::ofstream f(path, std::ios::binary | std::ios::trunc);
+      f.write(reinterpret_cast<const char*>(data), size);
+    }
+
+    // Copies a whole resource to a staging twin and writes every subresource
+    // (mip/slice) as raw rows: file = <base>.bin, layout in <base>.txt
+    void dumpResource(ID3D11DeviceContext* ctx, ID3D11Resource* res, const std::string& base, std::ofstream& info) {
+      Com<ID3D11Device> dev;
+      ctx->GetDevice(&dev);
+
+      D3D11_RESOURCE_DIMENSION dim = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+      res->GetType(&dim);
+
+      // Resource identity, so a replay can chain passes (output of one
+      // dispatch read by the next)
+      info << "  id=" << reinterpret_cast<uintptr_t>(res) << std::endl;
+
+      if (dim == D3D11_RESOURCE_DIMENSION_BUFFER) {
+        Com<ID3D11Buffer> buf;
+        res->QueryInterface(__uuidof(ID3D11Buffer), reinterpret_cast<void**>(&buf));
+
+        D3D11_BUFFER_DESC desc = { };
+        buf->GetDesc(&desc);
+        writeFile(base + ".bdesc", &desc, sizeof(desc));
+
+        D3D11_BUFFER_DESC sdesc = { };
+        sdesc.ByteWidth = desc.ByteWidth;
+        sdesc.Usage = D3D11_USAGE_STAGING;
+        sdesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        sdesc.StructureByteStride = desc.StructureByteStride;
+
+        Com<ID3D11Buffer> staging;
+        if (FAILED(dev->CreateBuffer(&sdesc, nullptr, &staging)))
+          return;
+
+        ctx->CopyResource(staging.ptr(), res);
+
+        D3D11_MAPPED_SUBRESOURCE map = { };
+        if (SUCCEEDED(ctx->Map(staging.ptr(), 0, D3D11_MAP_READ, 0, &map))) {
+          writeFile(base + ".bin", map.pData, desc.ByteWidth);
+          ctx->Unmap(staging.ptr(), 0);
+        }
+
+        info << "  buffer bytes=" << desc.ByteWidth << " bind=" << desc.BindFlags << " misc=" << desc.MiscFlags
+             << " stride=" << desc.StructureByteStride << std::endl;
+        return;
+      }
+
+      if (dim != D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+        info << "  (unsupported resource dimension " << uint32_t(dim) << ")" << std::endl;
+        return;
+      }
+
+      Com<ID3D11Texture2D> tex;
+      res->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void**>(&tex));
+
+      D3D11_TEXTURE2D_DESC desc = { };
+      tex->GetDesc(&desc);
+      writeFile(base + ".tdesc", &desc, sizeof(desc));
+
+      D3D11_TEXTURE2D_DESC sdesc = desc;
+      sdesc.Usage = D3D11_USAGE_STAGING;
+      sdesc.BindFlags = 0;
+      sdesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+      sdesc.MiscFlags = 0;
+
+      info << "  tex2d " << desc.Width << "x" << desc.Height << " fmt=" << uint32_t(desc.Format)
+           << " mips=" << desc.MipLevels << " array=" << desc.ArraySize << " samples=" << desc.SampleDesc.Count
+           << " bind=" << desc.BindFlags << " misc=" << desc.MiscFlags << std::endl;
+
+      if (desc.SampleDesc.Count > 1)
+        return;
+
+      Com<ID3D11Texture2D> staging;
+      if (FAILED(dev->CreateTexture2D(&sdesc, nullptr, &staging))) {
+        info << "  (staging copy failed)" << std::endl;
+        return;
+      }
+
+      ctx->CopyResource(staging.ptr(), res);
+
+      std::ofstream bin(base + ".bin", std::ios::binary | std::ios::trunc);
+      std::ofstream lay(base + ".txt", std::ios::trunc);
+
+      for (uint32_t a = 0; a < desc.ArraySize; a++) {
+        for (uint32_t m = 0; m < desc.MipLevels; m++) {
+          uint32_t sub = D3D11CalcSubresource(m, a, desc.MipLevels);
+          uint32_t h = std::max(desc.Height >> m, 1u);
+
+          D3D11_MAPPED_SUBRESOURCE map = { };
+          if (FAILED(ctx->Map(staging.ptr(), sub, D3D11_MAP_READ, 0, &map)))
+            continue;
+
+          // Block-compressed formats are not expected here; rows = height
+          lay << sub << " " << map.RowPitch << " " << h << " " << uint64_t(bin.tellp()) << std::endl;
+          bin.write(reinterpret_cast<const char*>(map.pData), size_t(map.RowPitch) * h);
+          ctx->Unmap(staging.ptr(), sub);
+        }
+      }
+    }
+
+    void captureBindings(ID3D11DeviceContext* ctx, const std::string& base, std::ofstream& info, bool post) {
+      if (!post) {
+        for (uint32_t i = 0; i < 16; i++) {
+          ID3D11ShaderResourceView* srv = nullptr;
+          ctx->CSGetShaderResources(i, 1, &srv);
+
+          if (!srv)
+            continue;
+
+          D3D11_SHADER_RESOURCE_VIEW_DESC vdesc = { };
+          srv->GetDesc(&vdesc);
+
+          std::string b = str::format(base, "_srv", i);
+          writeFile(b + ".vdesc", &vdesc, sizeof(vdesc));
+          info << "srv " << i << " viewfmt=" << uint32_t(vdesc.Format) << " viewdim=" << uint32_t(vdesc.ViewDimension) << std::endl;
+
+          Com<ID3D11Resource> res;
+          srv->GetResource(&res);
+          dumpResource(ctx, res.ptr(), b, info);
+          srv->Release();
+        }
+
+        for (uint32_t i = 0; i < 14; i++) {
+          ID3D11Buffer* cb = nullptr;
+          UINT first = 0, count = 0;
+          static_cast<ID3D11DeviceContext1*>(ctx)->CSGetConstantBuffers1(i, 1, &cb, &first, &count);
+
+          if (!cb)
+            continue;
+
+          info << "cb " << i << " first=" << first << " count=" << count << std::endl;
+          dumpResource(ctx, cb, str::format(base, "_cb", i), info);
+          cb->Release();
+        }
+
+        for (uint32_t i = 0; i < 16; i++) {
+          ID3D11SamplerState* smp = nullptr;
+          ctx->CSGetSamplers(i, 1, &smp);
+
+          if (!smp)
+            continue;
+
+          D3D11_SAMPLER_DESC sdesc = { };
+          smp->GetDesc(&sdesc);
+          writeFile(str::format(base, "_smp", i, ".sdesc"), &sdesc, sizeof(sdesc));
+          info << "sampler " << i << " filter=" << uint32_t(sdesc.Filter) << " addr=" << uint32_t(sdesc.AddressU)
+               << "," << uint32_t(sdesc.AddressV) << std::endl;
+          smp->Release();
+        }
+      }
+
+      for (uint32_t i = 0; i < 8; i++) {
+        ID3D11UnorderedAccessView* uav = nullptr;
+        ctx->CSGetUnorderedAccessViews(i, 1, &uav);
+
+        if (!uav)
+          continue;
+
+        D3D11_UNORDERED_ACCESS_VIEW_DESC vdesc = { };
+        uav->GetDesc(&vdesc);
+
+        std::string b = str::format(base, "_uav", i, post ? "_post" : "_pre");
+        writeFile(b + ".vdesc", &vdesc, sizeof(vdesc));
+        info << "uav " << i << (post ? " post" : " pre") << " viewfmt=" << uint32_t(vdesc.Format)
+             << " viewdim=" << uint32_t(vdesc.ViewDimension) << std::endl;
+
+        Com<ID3D11Resource> res;
+        uav->GetResource(&res);
+        dumpResource(ctx, res.ptr(), b, info);
+        uav->Release();
+      }
+    }
+
+  }
+
+
+  bool BsiCsCaptureActive() {
+    auto& s = state();
+
+    if (!s.init) {
+      s.dir = env::getEnvVar("BSI_CS_CAPTURE");
+      s.init = true;
+    }
+
+    if (s.dir.empty())
+      return false;
+
+    if (s.remaining)
+      return true;
+
+    std::string go = str::format(s.dir, "/go");
+
+    if (access(go.c_str(), F_OK))
+      return false;
+
+    uint32_t n = 3u;
+    { std::ifstream f(go);
+      uint32_t v = 0u;
+      if (f >> v && v)
+        n = v; }
+
+    s.session++;
+    s.remaining = n;
+    s.index = 0u;
+    s.out = str::format(s.dir, "/cap", s.session);
+
+    std::string cmd = str::format("mkdir -p '", s.out, "'");
+    if (system(cmd.c_str())) { }
+
+    std::rename(go.c_str(), str::format(s.dir, "/done", s.session).c_str());
+    Logger::info(str::format("BSI_CS_CAPTURE: capturing ", n, " dispatches to ", s.out));
+    return true;
+  }
+
+
+  void BsiCsCapture(
+          ID3D11DeviceContext*  ctx,
+    const std::string&          shaderName,
+          UINT                  x,
+          UINT                  y,
+          UINT                  z,
+          bool                  post) {
+    auto& s = state();
+
+    if (!s.remaining)
+      return;
+
+    std::string base = str::format(s.out, "/d", s.index);
+    std::ofstream info(base + "_info.txt", post ? std::ios::app : std::ios::trunc);
+
+    if (!post)
+      info << "shader " << shaderName << std::endl << "groups " << x << " " << y << " " << z << std::endl;
+
+    captureBindings(ctx, base, info, post);
+
+    if (post) {
+      s.index++;
+      s.remaining--;
+    }
+  }
+
+
+  void BsiCsCaptureOriginal(
+          ID3D11DeviceContext*   ctx,
+    const std::function<void()>& runOriginal) {
+    auto& s = state();
+
+    if (!s.remaining)
+      return;
+
+    Com<ID3D11Device> dev;
+    ctx->GetDevice(&dev);
+
+    // Save the content of every bound UAV resource
+    std::vector<std::pair<Com<ID3D11Resource>, Com<ID3D11Resource>>> saved;
+
+    for (uint32_t i = 0; i < 8; i++) {
+      ID3D11UnorderedAccessView* uav = nullptr;
+      ctx->CSGetUnorderedAccessViews(i, 1, &uav);
+
+      if (!uav)
+        continue;
+
+      Com<ID3D11Resource> res;
+      uav->GetResource(&res);
+      uav->Release();
+
+      Com<ID3D11Texture2D> tex;
+      if (FAILED(res->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void**>(&tex)))) {
+        Logger::warn("BSI_CS_CAPTURE_ORIG: non-texture UAV, original not run");
+        return;
+      }
+
+      D3D11_TEXTURE2D_DESC desc = { };
+      tex->GetDesc(&desc);
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      desc.BindFlags = 0;
+      desc.CPUAccessFlags = 0;
+      desc.MiscFlags = 0;
+
+      Com<ID3D11Texture2D> copy;
+      if (FAILED(dev->CreateTexture2D(&desc, nullptr, &copy))) {
+        Logger::warn("BSI_CS_CAPTURE_ORIG: cannot create UAV copy, original not run");
+        return;
+      }
+
+      ctx->CopyResource(copy.ptr(), res.ptr());
+      saved.push_back({ res, Com<ID3D11Resource>(copy.ptr()) });
+    }
+
+    runOriginal();
+
+    std::string base = str::format(s.out, "/d", s.index);
+    std::ofstream info(base + "_info.txt", std::ios::app);
+
+    for (uint32_t i = 0; i < 8; i++) {
+      ID3D11UnorderedAccessView* uav = nullptr;
+      ctx->CSGetUnorderedAccessViews(i, 1, &uav);
+
+      if (!uav)
+        continue;
+
+      info << "uav " << i << " orig" << std::endl;
+      Com<ID3D11Resource> res;
+      uav->GetResource(&res);
+      dumpResource(ctx, res.ptr(), str::format(base, "_uav", i, "_orig"), info);
+      uav->Release();
+    }
+
+    for (auto& p : saved)
+      ctx->CopyResource(p.first.ptr(), p.second.ptr());
+  }
+
+}
diff --git a/src/d3d11/d3d11_bsi_capture.h b/src/d3d11/d3d11_bsi_capture.h
new file mode 100644
--- /dev/null
+++ b/src/d3d11/d3d11_bsi_capture.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <functional>
+#include <string>
+
+#include "d3d11_include.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Debug capture of compute dispatches (BSI local patch)
+   *
+   * Off unless \c BSI_CS_CAPTURE=<dir> is set; see d3d11_bsi_capture.cpp.
+   * \returns \c true if the current dispatch should be captured
+   */
+  bool BsiCsCaptureActive();
+
+  void BsiCsCapture(
+          ID3D11DeviceContext*  ctx,
+    const std::string&          shaderName,
+          UINT                  x,
+          UINT                  y,
+          UINT                  z,
+          bool                  post);
+
+  /**
+   * \brief Runs the original code of a replaced shader during a capture
+   *
+   * Saves the bound UAV resources, calls \c runOriginal (which records a
+   * dispatch of the original shader), dumps the UAVs as \c _orig and
+   * restores their previous content, so the real dispatch that follows
+   * (the replacement) sees exactly the same inputs.
+   */
+  void BsiCsCaptureOriginal(
+          ID3D11DeviceContext*  ctx,
+    const std::function<void()>& runOriginal);
+
+}
diff --git a/src/dxvk/dxvk_shader_ir.cpp b/src/dxvk/dxvk_shader_ir.cpp
--- a/src/dxvk/dxvk_shader_ir.cpp
+++ b/src/dxvk/dxvk_shader_ir.cpp
@@ -2,9 +2,11 @@
 
 #include <spirv/spirv_builder.h>
 
+#include "../util/util_env.h"
 #include <util/util_log.h>
 
 #include "dxvk_shader_ir.h"
+#include "dxvk_shader_replace.h"
 
 namespace dxvk {
 
@@ -2022,6 +2024,48 @@
   SpirvCodeBuffer DxvkIrShader::getCode(
     const DxvkShaderBindingMap*       bindings,
     const DxvkShaderLinkage*          linkage) {
+    SpirvCodeBuffer code = buildCode(bindings, linkage);
+
+    // BSI local patch: replacement shader (BSI_SHADER_REPLACE)
+    if (auto repl = getValidReplacement()) {
+      SpirvCodeBuffer patched;
+
+      if (DxvkShaderReplacer::patch(m_debugName, *repl, code, patched)) {
+        if (!m_loggedReplacement.exchange(true))
+          Logger::info(str::format("BSI shader replacement: using ", repl->file, " for ", m_debugName));
+        return patched;
+      }
+    }
+
+    return code;
+  }
+
+
+  const DxvkShaderReplacement* DxvkIrShader::getValidReplacement() {
+    if (m_replDisabled || !DxvkShaderReplacer::has(m_debugName))
+      return nullptr;
+
+    std::call_once(m_replOnce, [this] {
+      // The variant must have been derived from exactly this code (same
+      // DXVK build, same device options): hash of the unmapped SPIR-V,
+      // which is also what DXVK_SHADER_DUMP_PATH writes as <name>.spv
+      SpirvCodeBuffer unmapped = buildCode(nullptr, nullptr);
+      auto repl = DxvkShaderReplacer::find(m_debugName, unmapped);
+
+      // Check that the interface can be matched before trusting it
+      SpirvCodeBuffer patched;
+
+      if (repl && DxvkShaderReplacer::patch(m_debugName, *repl, unmapped, patched))
+        m_repl = repl;
+    });
+
+    return m_repl;
+  }
+
+
+  SpirvCodeBuffer DxvkIrShader::buildCode(
+    const DxvkShaderBindingMap*       bindings,
+    const DxvkShaderLinkage*          linkage) {
