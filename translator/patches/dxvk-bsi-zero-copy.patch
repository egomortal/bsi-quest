 namespace dxvk {
 
+  /* BSI (local patch, never upstream): zero-copy mapped memory for the BioShock Infinite static recompilation.
+     The host runtime publishes BSI_GVA_HOOK="<alloc>,<free>" (hex host function pointers) before the device is
+     created. Host-visible memory that DXVK maps persistently is then placed inside the 32-bit guest's 4 GB address
+     window, so a guest Map() can return (mapPtr - guest base) and the game writes GPU-visible memory directly:
+       mode 1: VK_EXT_map_memory_placed (vkMapMemory2KHR at an address the runtime reserved; Turnip has it)
+       mode 2: VK_EXT_external_memory_host (import guest-window pages; lavapipe test path, chunk allocations only)
+     alloc(size, align) returns a 64 KB aligned host pointer inside the window or null (then DXVK maps normally);
+     free(ptr, size) gives the range back once the memory is unmapped/freed (mode 1 leaves a PROT_NONE reservation). */
+  namespace bsi {
+    typedef void* (*PFN_alloc)(size_t, size_t);
+    typedef void  (*PFN_free)(void*, size_t);
+    struct Hook { PFN_alloc alloc = nullptr; PFN_free free = nullptr; };
+    static const Hook& hook() {
+      static const Hook h = [] {
+        Hook r; const char* e = std::getenv("BSI_GVA_HOOK");
+        if (e) {
+          char* end = nullptr; unsigned long long a = std::strtoull(e, &end, 16);
+          if (end && *end == ',') {
+            unsigned long long f = std::strtoull(end + 1, nullptr, 16);
+            if (a && f) { r.alloc = reinterpret_cast<PFN_alloc>(uintptr_t(a)); r.free = reinterpret_cast<PFN_free>(uintptr_t(f)); }
+          }
+        }
+        return r; }();
+      return h;
+    }
+    constexpr VkDeviceSize Align = 64u << 10;
+  }
